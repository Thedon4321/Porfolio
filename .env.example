# Public site origin used for canonical/OG absolute URLs and sitemap (no trailing slash).
# Example: https://your-domain.com
# Set this on the hosting platform for production builds. Leave empty locally.
# Never invent localhost as the production origin.
VITE_SITE_URL=

# Contact provider mode:
#   endpoint — POST to VITE_CONTACT_FORM_ENDPOINT (Formspree / Web3Forms / Getform / etc.)
#   netlify  — POST to "/" for Netlify Forms (pair with the hidden form stub in index.html)
# Leave unset (and leave endpoint empty) until configured — the UI stays in a safe error state.
VITE_CONTACT_PROVIDER=

# Public form endpoint URL for endpoint mode. Never put private SMTP passwords here.
VITE_CONTACT_FORM_ENDPOINT=

# Optional public client access key (e.g. Web3Forms access_key).
# Designed for browser use — prefer host env vars for production; do not commit real keys
# if your policy forbids it.
VITE_CONTACT_ACCESS_KEY=
